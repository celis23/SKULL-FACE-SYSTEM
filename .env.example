# Copia este archivo a .env y cambia TODOS los valores antes de desplegar.
# .env está en .gitignore: nunca se sube al repositorio.

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=skull_face
MYSQL_USER=skull_face_app
MYSQL_PASSWORD=change_this_password

# --- Sesiones ---
# Genera uno con: openssl rand -hex 48
JWT_SECRET=change_this_jwt_secret

# --- Cuentas iniciales ---
# El backend las crea al arrancar si no existen. Si ya existen, NO las modifica.
ADMIN_USER=celis
ADMIN_PASSWORD=change_this_admin_password
RECEPCION_USER=tlaco
RECEPCION_PASSWORD=change_this_recepcion_password

# --- Seguridad ---
# Orígenes autorizados a llamar la API, separados por comas.
# El frontend y la API se sirven desde el mismo origen a través de Caddy, así que
# basta con la URL pública del sitio.
#   Sin dominio (hoy):  http://62.171.159.168
#   Con dominio:        https://tu-dominio.com
CORS_ORIGIN=http://62.171.159.168

# Peticiones por IP cada 15 min: general y para login/registro.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=5

# Nº de proxies delante de la API: nginx del compose (1) + Caddy del servidor (1) = 2.
TRUST_PROXY_HOPS=2

# HSTS fuerza HTTPS en el navegador durante un año. Déjalo en false mientras el sitio
# se sirva por IP sin certificado; ponlo en true al activar el dominio con HTTPS.
ENABLE_HSTS=false

# --- Publicación ---
# El frontend escucha solo en 127.0.0.1 y Caddy hace de proxy hacia este puerto.
# No lo pongas en 0.0.0.0: el firewall del servidor está inactivo.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8000
